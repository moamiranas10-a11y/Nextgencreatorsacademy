# ── Database ──────────────────────────────────────────────
# Free PostgreSQL options: Neon (neon.tech), Supabase, Railway, or Vercel Postgres.
DATABASE_URL="postgresql://user:password@host:5432/nextgen_academy?schema=public&sslmode=require"

# ── NextAuth ──────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# ── Public site info (safe to expose to the browser) ─────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_ACADEMY_NAME="Nextgen Creators Academy"
NEXT_PUBLIC_WHATSAPP_NUMBER="923000000000"

# ── First admin account (used only by prisma/seed.ts) ────
SEED_ADMIN_EMAIL="admin@nextgenacademy.pk"
SEED_ADMIN_PASSWORD="ChangeMe123!"
